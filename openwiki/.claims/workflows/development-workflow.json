        }
      ]
    },
    {
      "id": "claim_8406522e225b42fd981b9ed79704b2eb",
      "statement": "For shell commands the guard is advisory rather than exact: it splits a compound command and judges each part, requiring a redirection to name the protected path, counting in-place writers and interpreters wherever the path appears, and counting cp, mv and install only on their last argument; a redirection anywhere in a command naming a protected path is treated as a write, so a read whose output is redirected elsewhere is also refused.",
      "evidence": [
        {
          "resource": "repo://tools/hooks/protect_generated.sh",
          "version": "repo-file-v1:sha256:b9309302d2d451878352d62247cf7b27f747cdd961e3d7518e428d9404340d09"
        }
      ]
    },
    {
