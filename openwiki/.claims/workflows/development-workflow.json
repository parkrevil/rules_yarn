    {
      "id": "claim_8ed1afc7a93241f3be936b0294b4ab42",
      "statement": "The generated-file guard denies writes to OpenWiki's bookkeeping files and to anything under openspec/specs/, while leaving OpenWiki page bodies writable because the agent authors them during a run.",
