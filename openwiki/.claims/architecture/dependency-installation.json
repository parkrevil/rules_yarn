    {
      "id": "claim_359deee17a694dffb949f8cd8151606d",
      "statement": "Before installing, the driver has Yarn report each carried setting for the carried part of the project's document alone and for the install's configuration, refuses the install unless Yarn accepts the first and both agree, checks the lockfile's cache key against Yarn's compression level, then runs `install --immutable --mode=skip-build --check-cache`; a refused metadata request is reported as a lockfile that would have to change and a refused tarball request as an unselected package.",
      "evidence": [
        {
          "resource": "repo://yarn/private/install/driver.js#L217-L310",
          "version": "repo-lines-v1:sha256:73a64bf79fe1b7abdffcd61158257f176f43bd7c72c9e784587083b8cbd06ec0:"
        }
