    {
      "id": "claim_6578dca6d739426796f42238d905d747",
      "statement": "Yarn runs with a fixed environment: the Node.js directory as PATH, a private HOME, global and cache folders, global cache and mirror off, immutable installs, checksum mismatches thrown, the pnpm linker, scripts off and telemetry off; the install's own configuration file disables the network except 127.0.0.1, points the registry at the loopback server and injects no environment files.",
      "evidence": [
        {
          "resource": "repo://yarn/private/install/driver.js#L179-L211",
          "version": "repo-lines-v1:sha256:52db1de7a6992a3d758d08c01a17e7b673b2708a53aaff4616e46c3155f1df01:"
        }
