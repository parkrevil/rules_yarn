        }
      ]
    },
    {
      "id": "claim_7edaa2148ce149d29bbecf0321e9e16f",
      "statement": "release.yml runs on a pushed v*.*.* tag, when tag.yaml calls it, or when dispatched with an existing tag, and runs the reusable release workflow from bazel-contrib/.github with the release as a draft, then the publish workflow, then a finalize job that publishes the draft.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/release.yml",
          "version": "repo-file-v1:sha256:c21d3bbd74ea7acad0a231ced893c2014baee315f24c03dea95fa6e5d5b5dfaf"
        }
