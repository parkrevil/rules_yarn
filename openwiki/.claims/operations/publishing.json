    {
      "id": "claim_4937ff2c7dfc4c0bb7a1f0824afbd578",
      "statement": "v0.1.0 is released on GitHub and its registry pull request is open as a draft; until the registry merges it, a consumer adds a non-registry override, and because an override only takes effect in the root module, a module depending on rules_yarn cannot pass it on.",
      "evidence": [
        {
          "resource": "repo://README.md#L31-L55",
          "version": "repo-lines-v1:sha256:46d3ca458fa2d5569d7b6b056c682ba5103cfb2cdaaf7bb1922ec714c8c4816b:"
        },
        {
