load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//yarn/private:yarn_binary"],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//yarn/private:extensions"],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
)

starlark_doc_extract(
    name = "defs.doc_extract",
    src = "defs.bzl",
    render_main_repo_name = True,
    visibility = ["//tests/docs:__pkg__"],
    deps = [":defs"],
)

starlark_doc_extract(
    name = "extensions.doc_extract",
    src = "extensions.bzl",
    render_main_repo_name = True,
    visibility = ["//tests/docs:__pkg__"],
    deps = [":extensions"],
)

starlark_doc_extract(
    name = "providers.doc_extract",
    src = "providers.bzl",
    render_main_repo_name = True,
    visibility = ["//tests/docs:__pkg__"],
    deps = [":providers"],
)
