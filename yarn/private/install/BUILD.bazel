load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

# The Node.js programs. archive.js and extract.js are also defaults of
# attributes of the rule each install repository instantiates, so they are
# visible to them.
exports_files(
    [
        "archive.js",
        "extract.js",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "check.js",
        "conditions.js",
        "driver.js",
        "layout.js",
        "lockfile.js",
        "node_modules.bzl",
        "pin.cjs",
        "repository.bzl",
        "sources.js",
        "syml.js",
        "yarnrc.js",
    ],
    visibility = ["//tests:__subpackages__"],
)

bzl_library(
    name = "repository",
    srcs = ["repository.bzl"],
    visibility = ["//yarn/private:__pkg__"],
)

bzl_library(
    name = "tarball",
    srcs = ["tarball.bzl"],
    visibility = ["//yarn/private:__pkg__"],
)
