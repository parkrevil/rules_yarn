"""The rule an install repository uses to turn its layout into artifacts.

Each install repository holds a symlink to this file at its root and loads it
from its own root package. That keeps it unloadable from anywhere else, which
`visibility("private")` would otherwise make impossible for a repository other
than rules_yarn's.
"""

load("@rules_yarn//yarn:providers.bzl", "YarnNodeModulesInfo")

visibility("private")

NODE_TOOLCHAIN_TYPE = Label("@rules_nodejs//nodejs:toolchain_type")

# tar.bzl's bsdtar toolchain type at v0.10.9 (tar/toolchain/BUILD), whose
# TarInfo carries `binary` and `default_env` (tar/toolchain/toolchain.bzl).
TAR_TOOLCHAIN_TYPE = Label("@tar.bzl//tar/toolchain:type")

# Each part of the tree a dependency's or a scope's target holds, by the
# target's name: a depset of the artifacts `yarn_node_modules` declares, so
# that building a part runs only the actions of its own artifacts ("Requesting
# output files", site/en/extending/rules.md, Bazel 8.3.0 and 9.2.0).
_YarnNodeModulesPartsInfo = provider(
    doc = "The part of an install's tree each dependency's and scope's target holds.",
    fields = {"parts": "dict from a target's name to a struct of `files`, the depset of the artifacts it holds, and `root`, the execution path of the node_modules directory its link or scope is in."},
)

_HOST_PATH_ERROR = (
    "yarn_node_modules requires a file-backed Node.js toolchain, but the resolved " +
    "rules_nodejs toolchain only provides the host path \"{}\"."
)

def _yarn_node_modules_impl(ctx):
    nodeinfo = ctx.toolchains[NODE_TOOLCHAIN_TYPE].nodeinfo
    if not nodeinfo.node:
        fail(_HOST_PATH_ERROR.format(nodeinfo.node_path))

    files = []

    # Every artifact by its path relative to the repository root.
    by_path = {}

    # The repository's directory among the outputs, taken from an artifact's
    # path rather than from Label.workspace_root, which later Bazel versions
    # deprecate. Every artifact is declared relative to the repository root.
    repository_root = None

    # One action per package, so that each is cached on its own: a package
    # built from its pinned tarball is extracted and checked against the
    # manifest of the tree Yarn laid out (extract.js), in an exec group holding
    # both the Node.js toolchain that runs the check and the tar toolchain
    # whose bsdtar it runs — an action using two toolchains needs one
    # (auto-exec-groups.md, Bazel 8.3.0 and 9.2.0).
    extract_toolchains = ctx.exec_groups["extract"].toolchains
    extract_nodeinfo = extract_toolchains[NODE_TOOLCHAIN_TYPE].nodeinfo
    if ctx.attr.extracted and not extract_nodeinfo.node:
        fail(_HOST_PATH_ERROR.format(extract_nodeinfo.node_path))
    extract_node = extract_nodeinfo.node
    tarinfo = extract_toolchains[TAR_TOOLCHAIN_TYPE].tarinfo
    tarballs = [target.files.to_list()[0] for target in ctx.attr.tarballs]
    for manifest, entry in ctx.attr.extracted.items():
        index, path = entry.split(":", 1)
        tarball = tarballs[int(index)]
        manifest_file = manifest.files.to_list()[0]
        directory = ctx.actions.declare_directory(path)
        ctx.actions.run(
            executable = extract_node,
            arguments = [ctx.file._extract.path, "check", tarinfo.binary.path, tarball.path, manifest_file.path, directory.path, path],
            inputs = [ctx.file._extract, tarball, manifest_file],
            tools = [tarinfo.binary],
            outputs = [directory],
            env = tarinfo.default_env,
            exec_group = "extract",
            mnemonic = "YarnExtract",
            progress_message = "Extracting %{output}",
        )
        files.append(directory)
        by_path[path] = directory
        if repository_root == None:
            repository_root = directory.path[:-len(path)]

    for archive, path in ctx.attr.archives.items():
        directory = ctx.actions.declare_directory(path)
        ctx.actions.run(
            executable = nodeinfo.node,
            arguments = [ctx.file._archive.path, "unpack", archive.files.to_list()[0].path, directory.path],
            inputs = [ctx.file._archive] + archive.files.to_list(),
            outputs = [directory],
            mnemonic = "YarnUnpack",
            toolchain = NODE_TOOLCHAIN_TYPE,
            progress_message = "Unpacking %{output}",
        )
        files.append(directory)
        by_path[path] = directory
        if repository_root == None:
            repository_root = directory.path[:-len(path)]

    for path, target in ctx.attr.links.items() + ctx.attr.bins.items():
        link = ctx.actions.declare_symlink(path)
        ctx.actions.symlink(output = link, target_path = target)
        files.append(link)
        by_path[path] = link
        if repository_root == None:
            repository_root = link.path[:-len(path)]

    # A store package with the links in its own node_modules, where Yarn's
    # pnpm linker puts its dependencies:
    # node_modules/.store/<slug>/{package,node_modules/<name>}.
    store_links = {}
    for path in ctx.attr.links:
        if path.startswith("node_modules/.store/"):
            store = path[:path.index("/node_modules/", len("node_modules/.store/"))]
            store_links.setdefault(store + "/package", []).append(by_path[path])
    stores = {}
    parts = {}
    for link, packages in ctx.attr.dependencies.items():
        transitive = []
        for package in packages:
            if package not in stores:
                stores[package] = depset([by_path[package]] + store_links.get(package, []))
            transitive.append(stores[package])
        own = [by_path[link]] + [by_path[b] for b in ctx.attr.dependency_bins.get(link, [])]

        # The link is <node_modules>/<name> or <node_modules>/@<scope>/<name>.
        segments = link.split("/")
        owner = "/".join(segments[:-2] if segments[-2].startswith("@") else segments[:-1])
        parts[link] = struct(files = depset(own, transitive = transitive), root = repository_root + owner)
    for scope, links in ctx.attr.scopes.items():
        parts[scope] = struct(
            files = depset(transitive = [parts[link].files for link in links]),
            root = repository_root + scope.rpartition("/")[0],
        )

    files = depset(files)
    return [
        DefaultInfo(files = files, runfiles = ctx.runfiles(transitive_files = files)),
        _YarnNodeModulesPartsInfo(parts = parts),
        YarnNodeModulesInfo(
            layout_version = 1,
            files = files,
            root = repository_root + "node_modules" if repository_root != None else None,
            workspace_links = ctx.attr.workspace_links,
            architectures = ctx.attr.architectures,
            yarn_version = ctx.attr.yarn_version,
            node_version = ctx.attr.node_version,
        ),
    ]

yarn_node_modules = rule(
    implementation = _yarn_node_modules_impl,
    doc = "Unpacks an install's packages into directory artifacts and creates its links as symlink artifacts; also gives each direct dependency's and scope's part of them to `yarn_node_modules_part`.",
    attrs = {
        "architectures": attr.string_list_dict(),
        "bins": attr.string_dict(doc = "`.bin` entry path to its relative target."),
        "dependencies": attr.string_list_dict(
            doc = "A direct dependency's link to the store package directories it reaches.",
        ),
        "dependency_bins": attr.string_list_dict(
            doc = "A direct dependency's link to the `.bin` entries the install gives it.",
        ),
        "scopes": attr.string_list_dict(doc = "A scope's directory to its direct dependencies' links."),
        "links": attr.string_dict(doc = "Link path to its relative target."),
        "node_version": attr.string(),
        "archives": attr.label_keyed_string_dict(
            allow_files = [".rya"],
            doc = "Package archive to the directory it is unpacked into.",
        ),
        "extracted": attr.label_keyed_string_dict(
            allow_files = [".json"],
            doc = "Manifest of a package built from its tarball to `<index in tarballs>:<directory>`.",
        ),
        "tarballs": attr.label_list(
            allow_files = [".tgz"],
            doc = "The pinned tarballs packages are built from.",
        ),
        "workspace_links": attr.string_dict(),
        "yarn_version": attr.string(),
        "_archive": attr.label(
            allow_single_file = True,
            default = Label("@rules_yarn//yarn/private/install:archive.js"),
        ),
        "_extract": attr.label(
            allow_single_file = True,
            default = Label("@rules_yarn//yarn/private/install:extract.js"),
        ),
    },
    toolchains = [NODE_TOOLCHAIN_TYPE],
    exec_groups = {
        "extract": exec_group(toolchains = [NODE_TOOLCHAIN_TYPE, TAR_TOOLCHAIN_TYPE]),
    },
)

def _yarn_node_modules_part_impl(ctx):
    part = ctx.attr.node_modules[_YarnNodeModulesPartsInfo].parts[ctx.label.name]
    files = part.files
    info = ctx.attr.node_modules[YarnNodeModulesInfo]
    return [
        DefaultInfo(files = files, runfiles = ctx.runfiles(transitive_files = files)),
        YarnNodeModulesInfo(
            layout_version = info.layout_version,
            files = files,
            root = part.root,
            workspace_links = info.workspace_links,
            architectures = info.architectures,
            yarn_version = info.yarn_version,
            node_version = info.node_version,
        ),
    ]

yarn_node_modules_part = rule(
    implementation = _yarn_node_modules_part_impl,
    doc = "The part of an install's tree a direct dependency or a scope reaches, named after the dependency's link or the scope's directory.",
    attrs = {
        "node_modules": attr.label(
            mandatory = True,
            providers = [_YarnNodeModulesPartsInfo, YarnNodeModulesInfo],
        ),
    },
)

def _yarn_install_error_impl(ctx):
    fail(ctx.attr.message)

yarn_install_error = rule(
    implementation = _yarn_install_error_impl,
    doc = "Stands in for an install whose checks failed, and reports why when it is built, so that the repository's other targets — `pin` among them — still work.",
    attrs = {"message": attr.string(mandatory = True)},
)
