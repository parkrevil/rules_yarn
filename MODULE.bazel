"""Bazel rules for running the Yarn package manager."""

# Bazel 8.3.0 is where `repository_ctx.repo_metadata` arrives, which
# yarn/private/repositories.bzl calls. Declaring it means an older Bazel is
# turned away while the module graph resolves, instead of failing inside this
# ruleset's files.
# `version` stays at the placeholder in the repository. The Bazel Central
# Registry entry carries the real version, which `publish-to-bcr` supplies as
# a generated patch over the released archive — the same arrangement
# rules_shell uses.
module(
    name = "rules_yarn",
    version = "0.0.0",
    bazel_compatibility = [">=8.3.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", dev_dependency = True)
node.toolchain(node_version = "24.21.0")

register_toolchains(
    "//tests/yarn_binary:host_path_node_runtime_toolchain",
    dev_dependency = True,
)

yarn = use_extension("//yarn:extensions.bzl", "yarn", dev_dependency = True)
yarn.distribution(version = "4.18.0")
use_repo(yarn, "yarn")
