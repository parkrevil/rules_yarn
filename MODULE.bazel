"""Bazel rules for running the Yarn package manager."""

module(name = "rules_yarn")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", dev_dependency = True)
node.toolchain(node_version = "24.21.0")

register_toolchains(
    "//tests/yarn_binary:host_path_node_runtime_toolchain",
    dev_dependency = True,
)

yarn = use_extension("//yarn:extensions.bzl", "yarn", dev_dependency = True)
yarn.distribution(version = "4.18.0")
use_repo(yarn, "yarn")
