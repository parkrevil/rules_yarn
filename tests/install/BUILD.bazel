load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The Node test runner, which tests/docs uses too.
exports_files(
    ["node_test.sh"],
    visibility = ["//tests:__subpackages__"],
)

sh_test(
    name = "archive_test",
    size = "small",
    srcs = ["node_test.sh"],
    args = [
        "$(rlocationpath @nodejs//:node_bin)",
        "$(rlocationpath archive_test.js)",
    ],
    data = [
        "archive_test.js",
        "//yarn/private/install:archive.js",
        "@nodejs//:node_bin",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "lockfile_test",
    size = "small",
    srcs = ["node_test.sh"],
    args = [
        "$(rlocationpath @nodejs//:node_bin)",
        "$(rlocationpath lockfile_test.js)",
        "JS_YAML=$(rlocationpath @js_yaml//:index.js)",
    ],
    data = [
        "lockfile_test.js",
        "//yarn/private/install:lockfile.js",
        "//yarn/private/install:syml.js",
        "@js_yaml",
        "@js_yaml//:index.js",
        "@nodejs//:node_bin",
    ] + glob(["testdata/**"]),
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

