config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

# The host's bsdtar from tar.bzl, the binary the driver runs for the decision.
alias(
    name = "bsdtar",
    actual = select({
        ":darwin_amd64": "@bsd_tar_toolchains_darwin_amd64//:tar",
        ":darwin_arm64": "@bsd_tar_toolchains_darwin_arm64//:tar",
        ":linux_amd64": "@bsd_tar_toolchains_linux_amd64//:tar",
        ":linux_arm64": "@bsd_tar_toolchains_linux_arm64//:tar",
    }),
)

