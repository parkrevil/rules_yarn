"""The consumer the tests in tests/integration copy, change and build.

Each test works on its own copy, in its scratch directory, where `../../..` is
a copy of this repository's ruleset files. Running Bazel here by hand leaves
bazel-* symlinks that the root's `//...` then walks; remove them afterwards.
"""

bazel_dep(name = "parkrevil_rules_yarn")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

local_path_override(
    module_name = "parkrevil_rules_yarn",
    path = "../../..",
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.21.0")
use_repo(node, "nodejs")

yarn = use_extension("@parkrevil_rules_yarn//yarn:extensions.bzl", "yarn")
yarn.distribution(version = "4.18.0")
yarn.install(
    name = "npm",
    lockfile = "//:yarn.lock",
    package_json = "//:package.json",
    pins = "//:pins.json",
    supported_architectures = {},
    yarnrc = "//:.yarnrc.yml",
)
use_repo(yarn, "npm", "yarn")
