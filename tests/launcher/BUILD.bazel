load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//yarn:defs.bzl", "yarn_binary")

yarn_binary(
    name = "argv_probe",
    yarn = "argv_probe.cjs",
)

yarn_binary(
    name = "yarn",
    yarn = "@yarn",
)

genrule(
    name = "gen_resource",
    outs = ["resource.txt"],
    cmd = "echo resource-content > $@",
)

filegroup(
    name = "resource_entry",
    srcs = ["resource_probe.cjs"],
    data = [":resource.txt"],
)

yarn_binary(
    name = "resource_probe",
    yarn = ":resource_entry",
)

sh_test(
    name = "launcher_test",
    size = "small",
    srcs = ["launcher_test.sh"],
    args = [
        "$(rlocationpath :argv_probe)",
        "$(rlocationpath :resource_probe)",
    ],
    data = [
        ":argv_probe",
        ":resource_probe",
    ],
    deps = ["@rules_shell//shell/runfiles"],
)

sh_test(
    name = "yarn_cli_test",
    size = "small",
    srcs = ["yarn_cli_test.sh"],
    args = ["$(rlocationpath :yarn)"],
    data = [":yarn"],
    deps = ["@rules_shell//shell/runfiles"],
)

# Only a sandbox that blocks the network can show that Yarn does not need it,
# so this is the one target that depends on the tag being honoured.
sh_test(
    name = "yarn_offline_test",
    size = "small",
    srcs = ["yarn_offline_test.sh"],
    args = [
        "$(rlocationpath :yarn)",
        "4.18.0",
    ],
    data = [":yarn"],
    tags = ["block-network"],
    deps = ["@rules_shell//shell/runfiles"],
)
