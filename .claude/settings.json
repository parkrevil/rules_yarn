{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*Write|.*Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/protect_generated.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/okf_conformance.sh",
            "timeout": 60,
            "statusMessage": "Validating OKF bundle..."
          }
        ]
      }
    ]
  }
}
