load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":provider_root.bzl", "provider_root")

exports_files([
    ".yarnrc.yml",
    "package.json",
    "packages/app/package.json",
    "packages/lib/package.json",
    "patches/is-number.patch",
    "yarn.lock",
    "yarn_pins.json",
])

sh_test(
    name = "installed_test",
    size = "small",
    srcs = ["installed_test.sh"],
    args = [
        "$(rlocationpath @nodejs//:node_bin)",
        "$(rlocationpaths @npm//:node_modules)",
    ],
    data = [
        "@nodejs//:node_bin",
        "@npm//:node_modules",
    ],
    deps = ["@rules_shell//shell/runfiles"],
)

# Only a sandbox that blocks the network can show the tree does not need it.
sh_test(
    name = "offline_test",
    size = "small",
    srcs = ["offline_test.sh"],
    args = [
        "$(rlocationpath @nodejs//:node_bin)",
        "$(rlocationpaths @npm//:node_modules)",
    ],
    data = [
        "@nodejs//:node_bin",
        "@npm//:node_modules",
    ],
    tags = ["block-network"],
    deps = ["@rules_shell//shell/runfiles"],
)

# An action that finds a package through YarnNodeModulesInfo.root.
provider_root(
    name = "provider_root",
    node_modules = "@npm//:node_modules",
)

sh_test(
    name = "provider_root_test",
    size = "small",
    srcs = ["provider_root_test.sh"],
    args = ["$(rlocationpath :provider_root)"],
    data = [":provider_root"],
    deps = ["@rules_shell//shell/runfiles"],
)

# A direct dependency's own target: its runfiles hold only what it reaches.
[
    sh_test(
        name = "part_test_" + check["name"],
        size = "small",
        srcs = ["part_test.sh"],
        args = [
            "$(rlocationpath @nodejs//:node_bin)",
            check["link"],
            check["stores"],
            "$(rlocationpaths @npm//:" + check["link"] + ")",
        ],
        data = [
            "@nodejs//:node_bin",
            "@npm//:" + check["link"],
        ],
        deps = ["@rules_shell//shell/runfiles"],
    )
    for check in [
        {
            "link": "node_modules/is-number",
            "name": "is_number",
            "stores": "is-number-patch,js-tokens-npm-4.0.0",
        },
        {
            "link": "packages/app/node_modules/react-dom",
            "name": "react_dom",
            "stores": "js-tokens-npm-4.0.0,loose-envify-npm-1.4.0,react-dom-virtual,react-npm-18.3.1,scheduler-npm-0.23.2",
        },
        {
            "link": "node_modules/typescript",
            "name": "typescript",
            "stores": "typescript-patch",
        },
    ]
]

# A workspace dependency's target, whose YarnNodeModulesInfo.root is that
# workspace's node_modules.
provider_root(
    name = "provider_root_workspace_part",
    node_modules = "@npm//:packages/lib/node_modules/is-number",
)

sh_test(
    name = "provider_root_workspace_part_test",
    size = "small",
    srcs = ["provider_root_test.sh"],
    args = ["$(rlocationpath :provider_root_workspace_part)"],
    data = [":provider_root_workspace_part"],
    deps = ["@rules_shell//shell/runfiles"],
)
